# Copie ce fichier en .env et remplis les valeurs pour tester en local
ODDS_API_KEY=ta_cle_the_odds_api
GOOGLE_SHEET_ID=id_de_ton_google_sheet
# Note: la récupération d'actualité utilise le flux RSS public de Google News,
# aucune clé API n'est nécessaire pour cette partie.
# Chemin vers le fichier JSON du compte de service (en local uniquement,
# en CI on utilise la variable GOOGLE_SERVICE_ACCOUNT_JSON directement)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Sports à suivre (clés The Odds API), séparés par des virgules.
# Liste volontairement diversifiée pour couvrir plusieurs sports pariables en France.
# Liste complète des clés possibles: https://the-odds-api.com/sports-odds-data/sports-apis.html
# ATTENTION QUOTA: chaque sport_key = 1 requête/run. Avec 16 sports et 1 run/jour,
# ça consomme ~480 requêtes/mois sur les 500 gratuites. Retire des sports si tu
# augmentes la fréquence des runs.
SPORT_KEYS=soccer_epl,soccer_france_ligue_one,soccer_spain_la_liga,soccer_italy_serie_a,soccer_germany_bundesliga,soccer_uefa_champs_league_qualification,soccer_usa_mls,basketball_nba,basketball_wnba,americanfootball_nfl,americanfootball_nfl_preseason,baseball_mlb,tennis_atp_cincinnati_open,tennis_wta_cincinnati_open,mma_mixed_martial_arts,boxing_boxing

# Nombre max de matchs analysés par run (pour rester dans les quotas gratuits)
MAX_EVENTS=20

# Fenêtre de recherche cible des rencontres à venir, en heures (24 = prochaines 24h).
# Si aucune rencontre n'est trouvée dans cette fenêtre, le code élargit automatiquement
# à 48h puis 7 jours plutôt que de renvoyer une liste vide.
HOURS_AHEAD=24

# Nombre max de flux RSS diversifiés à utiliser (parmi les 3 sports dominants du jour)
MAX_RSS_FEEDS=15

# Nombre max de confrontations passées à récupérer par rencontre (historique face-à-face)
MAX_H2H_MATCHES=5

# Budget virtuel quotidien (EUR) réparti sur les paris qualifiés
DAILY_BUDGET_EUR=10

# Seuil de score de confiance minimum pour qu'un pari soit inclus dans la répartition
MIN_CONFIDENCE_FOR_BET=70
