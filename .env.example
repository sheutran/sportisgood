# Copie ce fichier en .env et remplis les valeurs pour tester en local
ODDS_API_KEY=ta_cle_the_odds_api
GOOGLE_CSE_API_KEY=ta_cle_google_custom_search
GOOGLE_CSE_ID=ton_search_engine_id
GOOGLE_SHEET_ID=id_de_ton_google_sheet
# Chemin vers le fichier JSON du compte de service (en local uniquement,
# en CI on utilise la variable GOOGLE_SERVICE_ACCOUNT_JSON directement)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Sports à suivre (clés The Odds API), séparés par des virgules
# Liste complète: https://the-odds-api.com/sports-odds-data/sports-apis.html
SPORT_KEYS=soccer_france_ligue_1,soccer_epl,soccer_uefa_champs_league,basketball_nba

# Nombre max de matchs analysés par run (pour rester dans les quotas gratuits)
MAX_EVENTS=15
